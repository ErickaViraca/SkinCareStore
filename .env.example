# Copia este archivo a `.env.local` y completa los valores. Nunca subas `.env.local` al repositorio.
# Cómo obtener cada valor: docs/CONFIGURACION-SERVICIOS.md

# --- Base de datos (Neon) ---
# Conexión de la aplicación (usuario soleil_app, con "-pooler" en el host).
DATABASE_URL=

# Solo en Vercel (producción): conexión del dueño (neondb_owner, sin -pooler) para aplicar migraciones al desplegar.
# DATABASE_URL_MIGRATIONS=

# Postgres para los tests de concurrencia y permisos (npm run test:postgres).
# Debe ser una base local o temporal, NUNCA Neon de producción ni de desarrollo.
DATABASE_URL_TEST=postgresql://postgres:test@localhost:5432/soleil_test

# --- Ingreso con Google (Auth.js) ---
# Clave para cifrar la sesión. Generarla con: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Fotos (Cloudflare R2), se usan desde la etapa 3d ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Nivel de detalle de los logs del servidor: debug | info | warn | error (por defecto: info).
LOG_LEVEL=info
